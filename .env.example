# ============================================================
# PAIMANA-INTEL Environment Configuration Template
# ============================================================

# Database Configuration (Default: SQLite local, Production: PostgreSQL)
SPRING_PROFILES_ACTIVE=default
DATABASE_URL=jdbc:sqlite:../paimana_canonical.db
DATABASE_USER=
DATABASE_PASSWORD=

# Python ML Microservice
PYTHON_SERVICE_URL=http://localhost:8000
PORT=8080

# Production PostgreSQL Profile (Optional)
# SPRING_PROFILES_ACTIVE=prod
# DATABASE_URL=jdbc:postgresql://localhost:5432/paimana_db
# DATABASE_USER=postgres
# DATABASE_PASSWORD=your_secure_password

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ML Model Paths
ACTIVE_MODEL_VERSION=1.0.0
MODELS_DIR=models
DATASET_DIR=primary_dataset
