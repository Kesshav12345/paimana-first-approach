# ─── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
env/
venv/
ENV/

# ─── ML training artefacts (keep trained model .cbm files in /models) ─────────
catboost_info/

# ─── Java build output (keep the fat JAR for Docker COPY) ─────────────────────
backend/target/*
!backend/target/paimana-backend-1.0.0.jar

# ─── Frontend build / deps ─────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/

# ─── Heavy data / source PDFs (NOT needed at runtime) ─────────────────────────
primary dataset/
scratch/
data/
src/

# ─── Large files that should not be committed ─────────────────────────────────
*.pdf
*.zip
*.tar.gz

# ─── OS / editor metadata ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/

# ─── Secrets ───────────────────────────────────────────────────────────────────
.env

# ─── Render / deployment tools (local only) ───────────────────────────────────
tools/
